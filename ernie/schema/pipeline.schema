class SensorPipeline : NodeGraph (
    doc = "A sensor processing graph that turns what a sensor's trace measured into its outputs, such as raw digital numbers, a processed image or a point cloud. Its outputs connect to its nodes' outputs and name what render variables can read. Sensors and render products bind it with pipeline:binding."
) {}

abstract class SensorNode : Shader (
    doc = "One step of a sensor pipeline, named by info:id. Token and bool inputs pick how the step is built, so changing one compiles the pipeline again, while numeric inputs are values that change without compiling."
) {}

class CameraSignal : SensorNode (
    doc = "The photoelectron rate a camera's trace measured, as its detector's channels see it. It's how a pipeline asks the trace for its signal."
) {
    token info:id = CameraSignal
    token inputs:layout = full (
        tracked
        allowed = [full, mosaic]
        group = "Signal"
        displayName = "Layout"
        doc = "full gives every pixel all of the pattern's channels. mosaic gives each pixel only the channel at its site, as a Bayer or other mosaic sensor reads it, which is the raw signal and takes a third of the memory. Patterns without a mosaic always give full."
    )
    token inputs:precision = float (
        tracked
        allowed = [float, half]
        group = "Signal"
        displayName = "Precision"
        doc = "Whether the rate is stored as 32-bit or 16-bit floats."
    )
}

class Integrate : SensorNode (
    doc = "Integrates the photoelectron rate over the exposure into mean photoelectrons."
) {
    token info:id = Integrate
    float inputs:time = 0 (
        tracked
        unit = seconds
        group = "Exposure"
        displayName = "Time"
        min = 0
        doc = "The integration time. 0 takes the camera's exposure:time."
    )
}

class Emva1288 : SensorNode (
    doc = "Adds a camera's noise as EMVA 1288 models it, from the camera's detector values. Dark current at the detector's temperature and photo response non-uniformity add to the mean, shot noise draws the collected charge, the full well clips it, and read noise and dark signal non-uniformity add to it."
) {
    token info:id = Emva1288
    token inputs:shot = poisson (
        tracked
        allowed = [poisson, gaussian, off]
        group = "Noise"
        displayName = "Shot Noise"
        doc = "poisson draws exact counts at low means and a normal approximation above about 20 electrons. gaussian always uses the normal approximation. off leaves the mean."
    )
    bool inputs:fixedPatterns = true (
        tracked
        group = "Noise"
        displayName = "Fixed Patterns"
        doc = "Whether photo response and dark signal non-uniformity apply. They stay fixed for a camera across frames and runs."
    )
    float inputs:time = 0 (
        tracked
        unit = seconds
        group = "Noise"
        displayName = "Time"
        min = 0
        doc = "The time dark current builds over. 0 takes the camera's exposure:time."
    )
}

class Adc : SensorNode (
    doc = "Converts charge to digital numbers with the detector's system gain scaled by exposure:iso, its black level and its bit depth."
) {
    token info:id = Adc
}

class Gain : SensorNode (
    doc = "Scales digital numbers, as a digital gain does."
) {
    token info:id = Gain
    float inputs:gain = 1 (
        tracked
        group = "Gain"
        displayName = "Gain"
        min = 0
        doc = "The factor applied."
    )
}

class ToColor : SensorNode (
    doc = "Maps digital numbers to scene-linear color between the black level and the largest value the bit depth holds. Red, green and blue channels become color, and a single channel becomes gray."
) {
    token info:id = ToColor
}

class Encode : SensorNode (
    doc = "Encodes scene-linear color for display, clamped to the displayable range."
) {
    token info:id = Encode
    token inputs:transfer = srgb (
        tracked
        allowed = [srgb, rec709]
        group = "Encode"
        displayName = "Transfer"
        doc = "srgb applies the sRGB curve, and rec709 the Rec. 709 camera curve."
    )
}

class Demosaic : SensorNode (
    doc = "Fills in every channel at every pixel of a mosaic, averaging the nearest samples of each channel around the pixel. Signals that aren't mosaics pass through."
) {
    token info:id = Demosaic
    token inputs:method = bilinear (
        tracked
        allowed = [bilinear]
        group = "Demosaic"
        displayName = "Method"
        doc = "bilinear averages the nearest samples of each channel within one pixel, which is bilinear interpolation on a Bayer mosaic."
    )
}

class GaussianPsf : SensorNode (
    doc = "Blurs the photoelectron rate by a Gaussian point spread function out to 3 pixels, as defocus or a lens's spread does. On a mosaic it averages only samples of the same channel."
) {
    token info:id = GaussianPsf
    float inputs:sigma = 0.7 (
        tracked
        group = "Optics"
        displayName = "Sigma"
        min = 0
        doc = "The spread's standard deviation in pixels."
    )
}

class Denoise : SensorNode (
    doc = "Smooths color with a bilateral filter out to 2 pixels, which keeps edges whose difference is much larger than sigmaRange."
) {
    token info:id = Denoise
    float inputs:sigmaSpace = 1 (
        tracked
        group = "Denoise"
        displayName = "Sigma Space"
        min = 0
        doc = "The filter's spatial standard deviation in pixels."
    )
    float inputs:sigmaRange = 0.05 (
        tracked
        group = "Denoise"
        displayName = "Sigma Range"
        min = 0
        doc = "How different in color two pixels may be and still average, as a standard deviation."
    )
}

class Vignette : SensorNode (
    doc = "Darkens the photoelectron rate toward the corners by 1 - strength r^2, where r is the distance from the image's center over half its diagonal, as a lens barrel's mechanical vignetting does. The natural cos^4 falloff is already in the rate."
) {
    token info:id = Vignette
    float inputs:strength = 0.3 (
        tracked
        group = "Optics"
        displayName = "Strength"
        min = 0
        max = 1
        doc = "How much darker the corners are, from 0 for none to 1 for black."
    )
}

class BlackLevel : SensorNode (
    doc = "Subtracts the detector's black level from digital numbers."
) {
    token info:id = BlackLevel
}

class WhiteBalance : SensorNode (
    doc = "Scales red, green and blue by fixed gains."
) {
    token info:id = WhiteBalance
    float3 inputs:gains = (1, 1, 1) (
        tracked
        group = "White Balance"
        displayName = "Gains"
        doc = "The red, green and blue gains."
    )
}

class Ccm : SensorNode (
    doc = "Applies a color correction matrix, taking the camera's red, green and blue to the working space's."
) {
    token info:id = Ccm
    float3 inputs:red = (1, 0, 0) (
        tracked
        group = "Matrix"
        displayName = "Red"
        doc = "The weights of the camera's red, green and blue in the output's red."
    )
    float3 inputs:green = (0, 1, 0) (
        tracked
        group = "Matrix"
        displayName = "Green"
        doc = "The weights of the camera's red, green and blue in the output's green."
    )
    float3 inputs:blue = (0, 0, 1) (
        tracked
        group = "Matrix"
        displayName = "Blue"
        doc = "The weights of the camera's red, green and blue in the output's blue."
    )
}

class Tone : SensorNode (
    doc = "Compresses scene-linear color into the displayable range."
) {
    token info:id = Tone
    token inputs:curve = none (
        tracked
        allowed = [none, reinhard, aces]
        group = "Tone"
        displayName = "Curve"
        doc = "none leaves color as it is, reinhard maps x to x / (1 + x), and aces applies Narkowicz's fit of the ACES filmic curve."
    )
}
