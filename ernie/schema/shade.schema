api class SurfaceDetailAPI (
    doc = "Perturbs a surface's shading: a normal map, detail normal and albedo maps at a finer tiling, and displacement."
) {
    normal3f inputs:normal = (0, 0, 1) (
        group = "Normal"
        displayName = "Normal"
        doc = "Tangent-space shading normal, usually from a normal map."
    )
    float inputs:normalStrength = 1 (
        group = "Normal"
        displayName = "Normal Strength"
        min = 0
        max = 2
        doc = "Scales how far the normal map tilts the shading normal."
    )
    bool inputs:enableDetail = false (
        group = "Detail"
        displayName = "Enable Detail"
        doc = "Layer detail normal and albedo maps over the surface at a finer tiling."
    )
    normal3f inputs:detailNormal = (0, 0, 1) (
        group = "Detail"
        displayName = "Detail Normal"
        enabledBy = "enableDetail"
        doc = "Tangent-space detail normal, blended onto the normal with reoriented normal mapping."
    )
    float inputs:detailNormalStrength = 1 (
        group = "Detail"
        displayName = "Detail Normal Strength"
        min = 0
        max = 2
        enabledBy = "enableDetail"
        doc = "Scales how far the detail normal map tilts the shading normal."
    )
    color3f inputs:detailAlbedo = (0.5, 0.5, 0.5) (
        group = "Detail"
        displayName = "Detail Albedo"
        enabledBy = "enableDetail"
        doc = "Overlaid on the surface's albedo. Mid grey leaves it unchanged."
    )
    float inputs:detailAlbedoStrength = 1 (
        group = "Detail"
        displayName = "Detail Albedo Strength"
        min = 0
        max = 1
        enabledBy = "enableDetail"
        doc = "How strongly the detail albedo overlays the albedo."
    )
    float2 inputs:detailScale = (8, 8) (
        group = "Detail"
        displayName = "Detail Tiling"
        enabledBy = "enableDetail"
        doc = "Detail repeats per repeat of the surface's mapping."
    )
    float2 inputs:detailOffset = (0, 0) (
        group = "Detail"
        displayName = "Detail Offset"
        enabledBy = "enableDetail"
        doc = "Shift of the detail maps, applied after their rotation and tiling."
    )
    float inputs:detailRotation = 0 (
        unit = degrees
        group = "Detail"
        displayName = "Detail Rotation"
        enabledBy = "enableDetail"
        doc = "Rotation of the detail maps, applied first."
    )
    bool inputs:detailHexTiling = false (
        group = "Detail"
        displayName = "Detail Hex Tiling"
        enabledBy = "enableDetail"
        doc = "Hex tile the detail maps to hide their repetition."
    )
    bool inputs:enableDisplacement = false (
        group = "Displacement"
        displayName = "Enable Displacement"
        doc = "Displace the surface by a height. It bumps the shading normal for now, without moving geometry."
    )
    float inputs:displacement = 0 (
        group = "Displacement"
        displayName = "Height"
        enabledBy = "enableDisplacement"
        doc = "Height along the normal, usually from a height map."
    )
    float inputs:displacementScale = 0.01 (
        unit = meters
        group = "Displacement"
        displayName = "Displacement Scale"
        enabledBy = "enableDisplacement"
        doc = "Distance a height of 1 moves the surface."
    )
    float inputs:displacementMidlevel = 0.5 (
        group = "Displacement"
        displayName = "Midlevel"
        min = 0
        max = 1
        enabledBy = "enableDisplacement"
        doc = "The height that leaves the surface where it is."
    )
}

abstract class Connectable : Typed (
    doc = "A prim whose inputs and outputs can connect to other shading prims' outputs, as UsdShadeConnectableAPI does."
) {
    prim[] connections:sources (
        tracked
        group = "Connections"
        displayName = "Sources"
        doc = "The shader each connection reads from, one per connected input."
    )
    token[] connections:inputs (
        tracked
        group = "Connections"
        displayName = "Inputs"
        doc = "The input or output each connection drives, such as diffuseColor or surface, in the same order as sources."
    )
    token[] connections:outputs (
        tracked
        group = "Connections"
        displayName = "Outputs"
        doc = "The output of the source each connection reads, such as rgb or r, in the same order as sources."
    )
}

abstract class Shader : Connectable (
    doc = "A shading node. A built-in node names itself with info:id, and a node written in Slang also records the file and struct it came from."
) {
    token info:id (
        tracked
        group = "Shader"
        displayName = "Shader Type"
        doc = "The node this shader runs."
    )
    token info:implementationSource = id (
        allowed = [id, sourceAsset]
        enum = ImplementationSource
        group = "Shader"
        displayName = "Implementation"
        doc = "Whether the node is named by info:id or loaded from info:slang:sourceAsset."
    )
    asset info:slang:sourceAsset (
        group = "Shader"
        displayName = "Slang File"
        doc = "The Slang file the node is written in."
    )
    token info:slang:sourceAsset:subIdentifier (
        group = "Shader"
        displayName = "Slang Node"
        doc = "The struct or function in the Slang file that is the node."
    )
}

class NodeGraph : Connectable (
    doc = "Groups shaders and can expose their outputs, such as outputs:surface."
) {
}

class UsdUVTexture : Shader (
    doc = "Reads a texture at a coordinate. Its outputs rgb, r, g, b and a pick the channels a connection reads."
) {
    token info:id = UsdUVTexture
    asset inputs:file (
        tracked
        group = "Texture"
        displayName = "File"
        doc = "The image to read."
    )
    float2 inputs:st = (0, 0) (
        group = "Texture"
        displayName = "Coordinate"
        doc = "The texture coordinate, usually connected to a primvar reader, a transform or a placement."
    )
    token inputs:wrapS = repeat (
        tracked
        allowed = [repeat, mirror, clamp, black]
        enum = TextureWrapMode
        group = "Texture"
        displayName = "Wrap S"
        doc = "How coordinates outside 0 to 1 wrap horizontally. Black reads transparent black."
    )
    token inputs:wrapT = repeat (
        tracked
        allowed = [repeat, mirror, clamp, black]
        enum = TextureWrapMode
        group = "Texture"
        displayName = "Wrap T"
        doc = "How coordinates outside 0 to 1 wrap vertically. Black reads transparent black."
    )
    float4 inputs:fallback = (0, 0, 0, 1) (
        group = "Texture"
        displayName = "Fallback"
        doc = "The value read when the file is missing or can't be loaded."
    )
    float4 inputs:scale = (1, 1, 1, 1) (
        group = "Texture"
        displayName = "Scale"
        doc = "Multiplies each channel read from the file, applied before bias. Normal maps use 2 and DirectX ones flip green with -2."
    )
    float4 inputs:bias = (0, 0, 0, 0) (
        group = "Texture"
        displayName = "Bias"
        doc = "Added to each channel after scale. Normal maps use -1 and DirectX ones use 1 on green."
    )
    token inputs:sourceColorSpace = auto (
        tracked
        allowed = [auto, raw, sRGB]
        enum = TextureColorSpace
        group = "Texture"
        displayName = "Color Space"
        doc = "How to decode the file. Auto treats colour inputs as sRGB and everything else as raw."
    )
}

class UsdPrimvarReader_float2 : Shader (
    doc = "Reads a float2 primvar, usually texture coordinates."
) {
    token info:id = UsdPrimvarReader_float2
    token inputs:varname = st (
        tracked
        group = "Primvar"
        displayName = "Primvar"
        doc = "The primvar to read."
    )
    float2 inputs:fallback = (0, 0) (
        group = "Primvar"
        displayName = "Fallback"
        doc = "The value read where the primvar is missing."
    )
}

class UsdTransform2d : Shader (
    doc = "Transforms a texture coordinate by scale, then rotation, then translation."
) {
    token info:id = UsdTransform2d
    float2 inputs:in = (0, 0) (
        group = "Transform"
        displayName = "In"
        doc = "The coordinate to transform, usually connected to a primvar reader."
    )
    float inputs:rotation = 0 (
        unit = degrees
        group = "Transform"
        displayName = "Rotation"
        doc = "Counterclockwise rotation about the origin."
    )
    float2 inputs:scale = (1, 1) (
        group = "Transform"
        displayName = "Scale"
        doc = "Scale about the origin, applied first."
    )
    float2 inputs:translation = (0, 0) (
        group = "Transform"
        displayName = "Translation"
        doc = "Shift applied last."
    )
}

class TexturePlacement : Shader (
    doc = "Places textures from a primvar or projected from the shaded position, then transformed and optionally hex tiled. Textures whose coordinates connect to one placement share it."
) {
    token info:id = TexturePlacement
    token inputs:projection = uv (
        allowed = [uv, planar, box, triplanar]
        enum = TextureProjection
        group = "Placement"
        displayName = "Projection"
        doc = "Where texture coordinates come from, either a primvar or the position projected onto the xy plane, onto the box face the normal points at, or onto all three axes blended."
    )
    token inputs:projectionSpace = object (
        allowed = [object, world]
        enum = TextureSpace
        group = "Placement"
        displayName = "Projection Space"
        doc = "Whether projected textures move with the object or stay fixed in the world."
    )
    token inputs:uvPrimvar = st (
        group = "Placement"
        displayName = "UV Primvar"
        doc = "The float2 primvar read when projection is uv."
    )
    float inputs:tileSize = 1 (
        unit = meters
        group = "Placement"
        displayName = "Tile Size"
        doc = "Length of one texture repeat for planar, box and triplanar projections."
    )
    float inputs:triplanarBlend = 0.25 (
        group = "Placement"
        displayName = "Triplanar Blend"
        min = 0
        max = 1
        doc = "How widely triplanar projections blend across edges. 0 gives hard box seams."
    )
    float2 inputs:uvScale = (1, 1) (
        group = "Placement"
        displayName = "Tiling"
        doc = "Repeats per unit of texture coordinate, applied first."
    )
    float2 inputs:uvOffset = (0, 0) (
        group = "Placement"
        displayName = "Offset"
        doc = "Shift applied after tiling and rotation."
    )
    float inputs:uvRotation = 0 (
        unit = degrees
        group = "Placement"
        displayName = "Rotation"
        doc = "Counterclockwise rotation about the texture origin, applied after tiling."
    )
    bool inputs:hexTiling = false (
        group = "Hex Tiling"
        displayName = "Hex Tiling"
        doc = "Blend randomly rotated and offset copies on a hex grid to hide repetition."
    )
    float inputs:hexTilingContrast = 0.5 (
        group = "Hex Tiling"
        displayName = "Contrast"
        min = 0
        max = 1
        enabledBy = "hexTiling"
        doc = "How sharply neighbouring hex tiles blend."
    )
    float inputs:hexTilingRotation = 180 (
        unit = degrees
        group = "Hex Tiling"
        displayName = "Rotation"
        min = 0
        max = 180
        enabledBy = "hexTiling"
        doc = "Largest random rotation of each hex tile."
    )
}

class Material : NodeGraph (
    doc = "A material bound to geometry. Its outputs:surface connection names the shader that shades it."
) {
}

class UsdPreviewSurface : Shader, SurfaceDetailAPI (
    doc = "USD's preview surface: a diffuse and specular surface with clearcoat, emission and opacity."
) {
    token info:id = UsdPreviewSurface
    color3f inputs:diffuseColor = (0.18, 0.18, 0.18) (
        group = "Diffuse"
        displayName = "Diffuse Color"
        doc = "Diffuse reflectance, or base color in the metallic workflow."
    )
    color3f inputs:emissiveColor = (0, 0, 0) (
        group = "Emission"
        displayName = "Emissive Color"
        doc = "Light emitted by the surface."
    )
    bool inputs:useSpecularWorkflow = false (
        group = "Specular"
        displayName = "Use Specular Workflow"
        doc = "Use specularColor rather than metallic."
    )
    color3f inputs:specularColor = (0, 0, 0) (
        group = "Specular"
        displayName = "Specular Color"
        enabledBy = "useSpecularWorkflow"
        doc = "Specular reflectance at normal incidence, in the specular workflow."
    )
    float inputs:metallic = 0 (
        group = "Specular"
        displayName = "Metallic"
        min = 0
        max = 1
        doc = "How metallic the surface is, in the metallic workflow."
    )
    float inputs:roughness = 0.5 (
        group = "Specular"
        displayName = "Roughness"
        min = 0
        max = 1
        doc = "Specular roughness, from mirror at 0 to rough at 1."
    )
    float inputs:ior = 1.5 (
        group = "Specular"
        displayName = "IOR"
        min = 1
        max = 3
        doc = "Index of refraction, which sets the Fresnel reflectance."
    )
    float inputs:clearcoat = 0 (
        group = "Clearcoat"
        displayName = "Clearcoat"
        min = 0
        max = 1
        doc = "Strength of a second, white specular layer."
    )
    float inputs:clearcoatRoughness = 0.01 (
        group = "Clearcoat"
        displayName = "Clearcoat Roughness"
        min = 0
        max = 1
        doc = "Roughness of the clearcoat layer."
    )
    float inputs:opacity = 1 (
        group = "Opacity"
        displayName = "Opacity"
        min = 0
        max = 1
        doc = "Opacity, from transparent at 0 to opaque at 1."
    )
    token inputs:opacityMode = transparent (
        allowed = [transparent, presence]
        group = "Opacity"
        displayName = "Opacity Mode"
        doc = "Whether zero opacity is a clear surface that still reflects, or no surface at all."
    )
    float inputs:opacityThreshold = 0 (
        group = "Opacity"
        displayName = "Opacity Threshold"
        min = 0
        max = 1
        doc = "Above zero, opacity cuts the surface out where it falls below this, rather than blending."
    )
    float inputs:occlusion = 1 (
        group = "Occlusion"
        displayName = "Occlusion"
        min = 0
        max = 1
        doc = "Ambient occlusion, from fully occluded at 0 to open at 1."
    )
}
