float3 LinearUplift(float nanometers) {
    const float at = clamp((nanometers - kLinearUpliftFirstNm) / kLinearUpliftStepNm, 0.0f,
                           float(kLinearUpliftSamples - 1));
    const uint below = min(uint(at), kLinearUpliftSamples - 2);
    return lerp(kLinearUplift[below], kLinearUplift[below + 1], at - float(below));
}
