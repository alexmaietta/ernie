    given-names: Alex
repository-code: "https://github.com/alexmaietta/ernie"
url: "https://alexmaietta.github.io/ernie/"
license: BSD-3-Clause
version: 0.1.0
keywords:
  - rendering
  - spectral rendering
  - Vulkan
  - planetary science
  - sensor simulation
  - reinforcement learning
  - robotics
