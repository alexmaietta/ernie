prefix=${pcfiledir}/@ernie_pc_to_prefix@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@

Name: @ernie_pc_name@
Description: @ernie_pc_description@
Version: @PROJECT_VERSION@
URL: @PROJECT_HOMEPAGE_URL@
Requires: @ernie_pc_requires@
Cflags: -I${includedir} @ernie_pc_dlpack@ @ernie_pc_cflags@
Libs: -L${libdir} -l@ernie_pc_library@
