cmake_minimum_required(VERSION 3.25)
function(ernie_hex_array file out_bytes out_size)
    file(READ "${file}" bytes HEX)
    string(LENGTH "${bytes}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(
        REGEX REPLACE "([0-9a-f][0-9a-f])"
        "0x\\1,"
        bytes
        "${bytes}"
    )
    string(
        REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})"
        "\\1\n"
        bytes
        "${bytes}"
    )
    set(${out_bytes} "${bytes}" PARENT_SCOPE)
    set(${out_size} "${size}" PARENT_SCOPE)
endfunction()

if(DEFINED INPUT)
    ernie_hex_array("${INPUT}" bytes size)
    file(
        WRITE "${OUTPUT}"
        "// Generated from ${INPUT}; do not edit.\n#include <cstddef>\n\nextern \"C\" {\n"
        "extern const unsigned char ${SYMBOL}[];\nextern const std::size_t ${SYMBOL}_size;\n"
        "const unsigned char ${SYMBOL}[] = {\n${bytes}\n};\n"
        "const std::size_t ${SYMBOL}_size = ${size};\n}\n"
    )
else()
    set(arrays "")
    set(entries "")
    set(index 0)
    string(
        REPLACE ","
        ";"
        roots
        "${ROOTS}"
    )
    foreach(root IN LISTS roots)
        string(
            REPLACE "|"
            ";"
            parts
            "${root}"
        )
        list(GET parts 0 directory)
        list(GET parts 1 prefix)
        list(GET parts 2 pattern)
        file(GLOB_RECURSE files RELATIVE "${directory}" "${directory}/${pattern}")
        list(SORT files)
        foreach(file IN LISTS files)
            ernie_hex_array("${directory}/${file}" bytes size)
            string(APPEND arrays "const unsigned char kFile${index}[] = {\n${bytes}0};\n")
            string(APPEND entries "    {\"${prefix}${file}\", kFile${index}, ${size}},\n")
            math(EXPR index "${index} + 1")
        endforeach()
    endforeach()

    string(
        REPLACE ","
        ";"
        uses
        "${USES}"
    )
    set(declarations "extern const KernelLibrary ${LIBRARY};\n")
    set(used "")
    foreach(library IN LISTS uses)
        string(APPEND declarations "extern const KernelLibrary ${library};\n")
        string(APPEND used "&${library}, ")
    endforeach()
    if(used)
        string(APPEND arrays "const KernelLibrary* const kUses[] = {${used}};\n")
        set(used ", kUses")
    endif()

    file(
        WRITE "${OUTPUT}.tmp"
        "// Generated from ${ROOTS}; do not edit.\n#include \"ernie/device/slang/kernel_library.h\"\n\n"
        "namespace ernie {\n\n${declarations}\nnamespace {\n\n${arrays}\n"
        "const EmbeddedKernel kFiles[] = {\n${entries}};\n\n}\n\n"
        "const KernelLibrary ${LIBRARY}{kFiles${used}};\n\n}\n"
    )
    execute_process(
        COMMAND
            "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}"
    )
    file(REMOVE "${OUTPUT}.tmp")
    if(DEFINED HEADER)
        file(
            WRITE "${HEADER}.tmp"
            "// Generated by cmake/ErnieEmbed.cmake; do not edit.\n#pragma once\n\n"
            "#include \"ernie/device/slang/kernel_library.h\"\n\n"
            "namespace ernie {\n\nextern const KernelLibrary ${LIBRARY};\n\n}\n"
        )
        execute_process(
            COMMAND
                "${CMAKE_COMMAND}" -E copy_if_different "${HEADER}.tmp" "${HEADER}"
        )
        file(REMOVE "${HEADER}.tmp")
    endif()
endif()
