# cmake -DSOURCE_DIR=<dir> -DOUTPUT=<file.cpp> -DSHADERS=<path=name,...> -P EmbedShaders.cmake
#
# Writes the definitions behind ernie/kernel/embedded_shaders.h: each shader under SOURCE_DIR as a
# raw string named by its entry. Run at build time, so a shader edit recompiles only this file.
string(
    CONCAT
    content
    "// Generated by cmake/EmbedShaders.cmake from ernie/kernel; do not edit.\n\n"
    "#include \"ernie/kernel/embedded_shaders.h\"\n\n"
    "namespace ernie::shaders {\n\n")
string(REPLACE "," ";" shaders "${SHADERS}")
foreach(entry ${shaders})
    string(REPLACE "=" ";" pair "${entry}")
    list(GET pair 0 path)
    list(GET pair 1 name)
    file(READ "${SOURCE_DIR}/${path}" source)
    string(APPEND content "const char ${name}[] = R\"slang(${source})slang\";\n\n")
endforeach()
string(APPEND content "}  // namespace ernie::shaders\n")
file(WRITE "${OUTPUT}" "${content}")
