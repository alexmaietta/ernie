string(
    CONCAT
        content
        "// Generated by cmake/EmbedShaders.cmake from ernie/kernel; do not edit.\n\n"
        "#include \"ernie/kernel/embedded_shaders.h\"\n\n"
        "namespace ernie::shaders {\n\n")
# Every .slang file is also a module named by its file stem, which
# `Modules()` lists so `import <stem>;` finds it.
set(modules "")
string(REPLACE "," ";" shaders "${SHADERS}")
foreach(entry ${shaders})
    string(REPLACE "=" ";" pair "${entry}")
    list(GET pair 0 path)
    list(GET pair 1 name)
    file(READ "${SOURCE_DIR}/${path}" source)
    string(APPEND content
           "const char ${name}[] = R\"slang(${source})slang\";\n\n")
    if(path MATCHES "\\.slang$")
        get_filename_component(stem "${path}" NAME_WE)
        string(APPEND modules "    {\"${stem}\", ${name}},\n")
    endif()
endforeach()
string(
    APPEND
    content
    "namespace {\n\n"
    "constexpr EmbeddedModule kModules[] = {\n${modules}};\n\n"
    "}  // namespace\n\n"
    "std::span<const EmbeddedModule> Modules() {\n"
    "    return kModules;\n"
    "}\n\n"
    "}  // namespace ernie::shaders\n")
file(WRITE "${OUTPUT}" "${content}")
